{
  "name": "furnace-evm",
  "version": "5.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "canonical:sums": "node scripts/verify-canonical.mjs",
    "canonical:test": "npm --prefix canonical install --no-audit --no-fund --no-package-lock && npm --prefix canonical test && npm --prefix canonical run check:config && node scripts/verify-canonical.mjs",
    "config:hash": "tsx scripts/config-hash.ts",
    "config:verify-hash": "tsx scripts/config-hash.ts --expect",
    "verify:create3": "tsx scripts/verify-create3.ts",
    "gen": "tsx scripts/gen-solidity.ts",
    "gen:check": "tsx scripts/gen-solidity.ts --check",
    "build:sol": "node tools/forge.mjs build",
    "test:sol": "node tools/forge.mjs test",
    "forge:sizes": "node tools/forge.mjs build --sizes --skip test --skip script",
    "gas": "node tools/forge.mjs test --isolate --match-test test_gas -vv",
    "sim:dev": "pnpm --filter @furnace/forge-sim dev",
    "sim:build": "pnpm --filter @furnace/forge-sim build",
    "sim:test": "pnpm --filter @furnace/forge-sim typecheck && pnpm --filter @furnace/forge-sim test",
    "app:dev": "pnpm --filter @furnace/forge-app dev",
    "app:build": "pnpm --filter @furnace/forge-app build",
    "app:test": "pnpm --filter @furnace/forge-app typecheck && pnpm --filter @furnace/forge-app test",
    "check": "pnpm typecheck && pnpm canonical:sums && pnpm config:verify-hash && pnpm verify:create3 && pnpm gen:check && pnpm sim:test && pnpm sim:build && pnpm app:test && pnpm app:build && pnpm forge:gate && pnpm forge:sizes && pnpm check:layout && pnpm test:sol && pnpm abi:check && pnpm mainnet:gate:check && pnpm provisional:check",
    "check:all": "pnpm check && pnpm canonical:test",
    "forge:gate": "node scripts/check-forge-gate.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "abi": "node scripts/export-abi.mjs",
    "abi:check": "node scripts/export-abi.mjs --check",
    "testnet:dry-run": "node tools/forge.mjs script contracts/script/DeployTestnet.s.sol:DeployTestnet --rpc-url liteforge",
    "testnet:deploy": "node tools/forge.mjs script contracts/script/DeployTestnet.s.sol:DeployTestnet --rpc-url liteforge --broadcast --slow",
    "testnet:pairs:dry-run": "node tools/forge.mjs script contracts/script/DeployTestnet.s.sol:DeployTestnetPairs --rpc-url liteforge",
    "testnet:pairs:deploy": "node tools/forge.mjs script contracts/script/DeployTestnet.s.sol:DeployTestnetPairs --rpc-url liteforge --broadcast --slow",
    "testnet:kindling:settle": "node tools/forge.mjs script contracts/script/DeployTestnet.s.sol:KindlingSettle --rpc-url liteforge --broadcast --slow",
    "testnet:ignition:close": "node tools/forge.mjs script contracts/script/DeployTestnet.s.sol:IgnitionClose --rpc-url liteforge --broadcast --slow",
    "mainnet:gate": "tsx scripts/mainnet-gate.ts",
    "mainnet:gate:check": "tsx scripts/mainnet-gate.ts --expect-blocked",
    "provisional": "node scripts/provisional-register.mjs",
    "provisional:check": "node scripts/provisional-register.mjs --check"
  },
  "devDependencies": {
    "@foundry-rs/forge": "1.7.1",
    "@noble/hashes": "^1.8.0",
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "^22.20.5",
    "solc": "0.8.28",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
