{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@model/*": ["../../scripts/*"],
      "@canonical/*": ["../../canonical/*"],
      "@sim/*": ["../forge-sim/src/*"],
      "@repo/*": ["../../*"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
