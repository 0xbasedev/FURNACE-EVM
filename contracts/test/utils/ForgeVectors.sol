pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";

/// @notice Loads the ForgePool scenarios generated by `pnpm gen` (scripts/forge-scenarios.ts).
abstract contract ForgeVectors is Test {
    string internal forgeJson;

    function _loadForgeVectors() internal {
        forgeJson = vm.readFile(string.concat(vm.projectRoot(), "/contracts/test/fixtures/forge-vectors.json"));
    }

    function _forgeUints(string memory key) internal view returns (uint256[] memory out) {
        string[] memory raw = vm.parseJsonStringArray(forgeJson, key);
        out = new uint256[](raw.length);
        for (uint256 i; i < raw.length; ++i) out[i] = vm.parseUint(raw[i]);
    }

    function _forgeHashes(string memory key) internal view returns (bytes32[] memory out) {
        string[] memory raw = vm.parseJsonStringArray(forgeJson, key);
        out = new bytes32[](raw.length);
        for (uint256 i; i < raw.length; ++i) out[i] = vm.parseBytes32(raw[i]);
    }
}
